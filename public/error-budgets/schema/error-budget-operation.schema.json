{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ortiz-luis.github.io/error-budgets/schema/error-budget-operation.schema.json",
  "title": "Error Budget Operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "short_name", "title", "description", "icon", "status",
    "source_branch", "current_error_pct", "uncertainty_error_pp", "spec_error_pct",
    "known_attribution_pct", "live_at", "snapshot_id", "protocol", "benchmark",
    "metric_convention", "measurement_chain", "operating_point", "target_note",
    "contributors", "literature_anchors"
  ],
  "properties": {
    "schema_version": {"const": "error-budget-operation-1.0"},
    "id": {"enum": ["1q", "2q", "movement", "initialization", "readout", "addressability", "analog"]},
    "short_name": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "minLength": 1},
    "status": {"enum": ["ON_TRACK", "AT_RISK", "OFF_TRACK", "UNKNOWN"]},
    "source_branch": {"type": "string", "pattern": "^error-budgets-data/(1q|2q|movement|initialization|readout|addressability|analog)$"},
    "current_error_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "uncertainty_error_pp": {"type": "number", "minimum": 0, "maximum": 100},
    "spec_error_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "known_attribution_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "live_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "benchmark": {"type": "string", "minLength": 1},
    "metric_convention": {"type": "string", "minLength": 1},
    "measurement_chain": {"type": "string", "minLength": 1},
    "operating_point": {"type": "string", "minLength": 1},
    "target_note": {"type": "string", "minLength": 1},
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "share_pct", "share_uncertainty_pct", "impact_error_pp", "uncertainty_pp", "evidence", "confidence", "owner"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "share_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "share_uncertainty_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "impact_error_pp": {"type": "number", "minimum": 0, "maximum": 100},
          "uncertainty_pp": {"type": "number", "minimum": 0, "maximum": 100},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "owner": {"type": ["string", "null"]}
        }
      }
    },
    "literature_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "note"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
